# Production build guardrail.
# Empty VITE_API_BASE forces the API client to use a relative "/api" base so the
# bundle calls the same origin Flask serves it from (single-origin Railway deploy).
# Do NOT recreate frontend/.env.local with a VITE_API_BASE value — .env.local has
# higher precedence than this file and will poison the production build.
VITE_API_BASE=
