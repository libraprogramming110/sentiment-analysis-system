# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# LLM model identifier
GROQ_MODEL=llama-3.3-70b-versatile

# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=5000

# Optional: Gemini fallback (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
